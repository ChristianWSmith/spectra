# Wails v3 project layout, Go module, binaries, and platform build trees
# live under src/ — see src/.gitignore for those patterns.

# Per-worktree XDG instance dirs (see AGENTS.md "Instance isolation (XDG)")
.xdg/

# Release artifacts produced by `make artifact`
*.zip
SHA256SUMS

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Session working notes (untracked reference)
.opencode/*
!.opencode/skills/
!.opencode/agents/
!.opencode/plugins/
!.opencode/opencode.json

# CS2 Demos
*.zst
*.dem
# …except the golden demo selection in golden/, tracked via Git LFS
!golden/*.dem.zst

# stray `go build .` / `go build ./cmd/cs2find` output — see src/.gitignore
