# Wails v3 project layout
.task
bin/
frontend/dist/
frontend/bindings/
frontend/node_modules/

# Mobile-only scaffolding: unsupported platforms (macOS/Linux/Windows
# desktop only). `wails3 update build-assets` re-extracts the stock iOS/
# Android trees from the CLI's embedded template; keep them untracked.
build/ios/
build/android/

# Release artifacts produced by `make artifact`
*.zip
SHA256SUMS

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Session working notes (untracked reference)
.opencode/*
!.opencode/skills/
!.opencode/agents/
!.opencode/opencode.json

# CS2 Demos
*.zst
*.dem
# …except the golden demo selection in golden/, tracked via Git LFS
!golden/*.dem.zst

# stray `go build .` output (root package binary)
/spectra
